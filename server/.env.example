# Código de acesso à tela de entrada — só quem deve entrar sabe esse valor.
# Obrigatório: sem essa variável o servidor recusa qualquer login (não há mais
# valor padrão embutido no código).
ACCESS_CODE=troque_por_um_codigo_seu

# Segredo usado pra assinar o token de sessão emitido após o login (protege as
# rotas /api/ask e /api/tts — sem um token válido, a API recusa a chamada).
# Gere um valor aleatório forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque_por_um_valor_aleatorio_longo

# Domínio(s) autorizados a chamar esta API (separados por vírgula). Em produção,
# defina com a URL do seu front-end no Vercel — sem isso, qualquer site pode
# chamar a API livremente.
# ALLOWED_ORIGIN=https://seu-app.vercel.app

GROQ_API_KEY=coloque_sua_chave_aqui
GROQ_MODEL=openai/gpt-oss-120b

GOOGLE_TTS_API_KEY=coloque_sua_chave_aqui
GOOGLE_TTS_VOICE=pt-BR-Chirp3-HD-Erinome
GOOGLE_TTS_PITCH=-4.0
GOOGLE_TTS_RATE=0.92
GOOGLE_TTS_SENTENCE_PAUSE_MS=480
GOOGLE_TTS_COMMA_PAUSE_MS=200
MINEIRO_ACCENT=true

PORT=3001
